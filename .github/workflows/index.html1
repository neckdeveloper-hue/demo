<style>
:root{--ink:#10263b;--ice:#eaf3f7;--paper:#f7fafb;--sky:#8cc0da;--deep:#1d5d86;--sun:#f4a712;--line:#10263b22;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--paper:#f7fafb}}
*,*:before,*:after{box-sizing:inherit}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.6 Figtree,system-ui,sans-serif;background-image:radial-gradient(#10263b0d 1px,transparent 1px);background-size:7px 7px}
h1,h2,h3{font-family:'Young Serif',Georgia,serif;font-weight:400;line-height:1.12;margin:0}
a{color:inherit}img,video{max-width:100%;display:block}
.w{max-width:1120px;margin:0 auto;padding:0 20px}
.hand{font-family:Caveat,cursive;font-weight:600}
.top{background:var(--ink);color:#fff;font-size:14px}.top .w{display:flex;justify-content:space-between;gap:12px;padding:7px 20px;flex-wrap:wrap}
header{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:2px solid var(--ink)}
header .w{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:'Young Serif';font-size:24px;text-decoration:none;color:var(--ink)}.logo b{color:var(--deep);font-weight:400}
nav{display:flex;gap:22px;align-items:center}nav a{text-decoration:none;font-weight:500;font-size:15px}nav a:hover{text-decoration:underline wavy var(--sky)}
.btn{display:inline-block;background:var(--sun);color:var(--ink);font-weight:700;padding:13px 22px;border:2px solid var(--ink);border-radius:10px 14px 11px 15px;text-decoration:none;box-shadow:3px 3px 0 var(--ink);cursor:pointer;font:700 16px Figtree;transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}.btn.alt{background:#fff}
#mb{display:none;background:none;border:2px solid var(--ink);border-radius:8px;padding:8px 10px;font:700 15px Figtree}
.hero{padding:44px 0 70px;position:relative}.hero .w{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(38px,6vw,68px)}.hero h1 span{display:block;color:var(--deep)}
.hero p.lead{font-size:19px;max-width:30em;margin:18px 0 26px}.cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.note{position:relative;margin-left:6px;font-size:23px;color:var(--deep);transform:rotate(-4deg)}
.uline{display:block;width:290px;max-width:80%;height:14px;margin-top:4px}
.stats{display:flex;gap:22px;margin-top:30px;flex-wrap:wrap;font-weight:500}.stats div{border-left:3px solid var(--sky);padding-left:12px}.stats b{display:block;font:400 24px 'Young Serif'}
.prints{position:relative;height:430px}.pr{position:absolute;background:#fff;padding:9px 9px 26px;border:1px solid var(--line);box-shadow:0 6px 0 #10263b14,0 14px 24px #10263b22}
.pr img{width:100%;height:auto;image-rendering:auto}.pr:before{content:"";position:absolute;top:-11px;left:50%;width:70px;height:22px;margin-left:-35px;background:#f4a71288;transform:rotate(-3deg)}
.pr.a{width:62%;left:0;top:10px;transform:rotate(-4deg)}.pr.b{width:44%;right:0;top:0;transform:rotate(5deg)}.pr.c{width:60%;right:6%;bottom:0;transform:rotate(-2deg)}
.pr figcaption{position:absolute;bottom:3px;left:10px;font:600 17px Caveat}
.stamp{position:absolute;left:-6px;bottom:30px;width:104px;height:104px;border:3px solid var(--deep);border-radius:50%;display:grid;place-items:center;text-align:center;color:var(--deep);transform:rotate(-12deg);font:400 15px/1.1 'Young Serif';background:var(--paper);outline:2px dashed var(--deep);outline-offset:-9px}
.stamp b{font-size:30px;display:block;font-weight:400}
.hero .load{animation:up .8s cubic-bezier(.2,.7,.2,1) both}@keyframes up{from{opacity:0;transform:translateY(22px)}}
section{padding:64px 0}.ice{background:var(--ice);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}
h2{font-size:clamp(30px,4.4vw,46px);margin-bottom:12px}.sub{max-width:36em;margin:0 0 34px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.card{background:#fff;border:2px solid var(--ink);padding:20px;border-radius:14px 10px 16px 11px}.card:nth-child(even){border-radius:10px 16px 11px 14px}
.card svg{width:64px;height:64px;margin-bottom:8px;filter:url(#wob)}.card h3{font-size:20px;margin-bottom:6px}.card p{margin:0 0 12px;font-size:15px}
.card a{font-weight:700;font-size:14px;color:var(--deep)}
svg .s{fill:none;stroke:var(--ink);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}svg .f{fill:var(--sky);stroke:var(--ink);stroke-width:2.6;stroke-linejoin:round}
.two{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start}
.sheet{background:#fff;border:2px solid var(--ink);padding:26px;border-radius:12px;box-shadow:6px 6px 0 var(--ink)}
.about p{max-width:34em}.sign{font-size:30px;color:var(--deep);margin-top:6px}
ol.steps{list-style:none;margin:0;padding:0 0 0 30px;border-left:3px dashed var(--deep);counter-reset:s}
ol.steps li{position:relative;padding:0 0 26px 26px;counter-increment:s}ol.steps li:before{content:counter(s);position:absolute;left:-47px;top:0;width:32px;height:32px;border-radius:50%;background:var(--sun);border:2px solid var(--ink);display:grid;place-items:center;font:400 16px 'Young Serif'}
ol.steps b{display:block;font:400 20px 'Young Serif'}
.work{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start}.work video{width:100%;border:2px solid var(--ink);border-radius:12px;background:#000;max-height:480px}
.vcap{font:600 21px Caveat;margin-top:6px}
.rev{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 4px 20px;scrollbar-width:thin}
.rc{flex:0 0 min(340px,82%);scroll-snap-align:start;background:#fffdf3;border:2px solid var(--ink);border-radius:6px 14px 8px 12px;padding:20px;box-shadow:4px 4px 0 var(--ink)}
.rc:nth-child(odd){transform:rotate(-.8deg)}.rc:nth-child(even){transform:rotate(.7deg)}
.st{color:var(--sun);letter-spacing:2px;font-size:19px;-webkit-text-stroke:1px var(--ink)}.rc p{margin:8px 0 12px}.rc small{display:block;opacity:.75}.rep{margin-top:10px;font:600 18px Caveat;color:var(--deep)}
.arr{display:flex;gap:10px;margin-bottom:12px}.arr button{width:44px;height:44px;border:2px solid var(--ink);background:#fff;border-radius:50%;font:700 20px Figtree;cursor:pointer}
form{display:grid;gap:14px}label{font-weight:700;font-size:14px;display:grid;gap:5px}
input,select,textarea{font:17px Figtree;padding:12px;border:2px solid var(--ink);border-radius:8px;background:#fff;color:var(--ink);width:100%}
input:focus,select:focus,textarea:focus,.btn:focus-visible,a:focus-visible,button:focus-visible{outline:3px solid var(--deep);outline-offset:2px}
.er{color:#b3261e;font-size:13px;min-height:0;font-weight:500}.ok{display:none;background:var(--ice);border:2px solid var(--deep);padding:12px;border-radius:8px;font-weight:500}
.info p{margin:0 0 14px}.info b{display:block;font:400 18px 'Young Serif'}
footer{background:var(--ink);color:#dbe8f0;padding:36px 0 90px;font-size:15px}footer .w{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}
footer a{color:#fff}
.fab{display:none;position:fixed;left:0;right:0;bottom:0;z-index:30;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));background:var(--paper);border-top:2px solid var(--ink);gap:10px}.fab a{flex:1;text-align:center}
@media(max-width:860px){.hero .w,.two{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.work{grid-template-columns:1fr 1fr}.prints{height:380px;max-width:460px}
#mb{display:block}nav{display:none;position:absolute;top:64px;left:0;right:0;background:var(--paper);flex-direction:column;align-items:flex-start;padding:16px 20px;border-bottom:2px solid var(--ink)}nav.open{display:flex}.fab{display:flex}.top .w span:last-child{display:none}}
@media(max-width:520px){.grid,.work{grid-template-columns:1fr}.prints{height:340px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important;transition:none!important}}
