["Fridge, cooler, freezer","We also handle water coolers, deep freezers and other cooling.","<rect class='f' x='16' y='6' width='32' height='52' rx='4'/><path class='s' d='M16 26h32M22 14v6M22 32v10'/>"],
["Emergency service","Open 24 hours. Call any time, day or night.","<circle class='f' cx='32' cy='32' r='24'/><path class='s' d='M32 16v16l10 6'/>"]];
const g=document.getElementById('sg'),ss=document.getElementById('ss');
S.forEach(([t,d,p])=>{g.insertAdjacentHTML('beforeend',`<div class="card"><svg viewBox="0 0 64 64" aria-hidden="true">${p}</svg><h3>${t}</h3><p>${d}</p><a href="#contact" data-svc="${t}">Book this</a></div>`);ss.add(new Option(t))});
ss.add(new Option("Annual Service Contract"));
document.addEventListener('click',e=>{const a=e.target.closest('[data-svc]');if(a)ss.value=a.dataset.svc});
const R=[["Miss Arpita","a year ago","Excellent service! The AC installation was done very professionally and efficiently. The technician was knowledgeable, polite, and ensured everything was set up perfectly. The cooling performance is great, and the overall experience was …","Techno Cool replied with a heart"],
["Hitesh Raghani","2 months ago","Providing good ac service recommended always"],["Amrat Bhai vagela","3 months ago","Good service and installation recommended always ."],["vicky ailsinghani","4 months ago","Best ac service provider in ahmedabad on time"],["Anis shaikh","5 months ago","Recommended Good installation humble & professional staff."],["Sunil Sunil","2 months ago","Good staff good technician always recommended"],["Alifiya Bandolier Wala","5 months ago","Really polite and helpful, and really fast services available definitely recommended"]];
const rv=document.getElementById('rv');R.forEach(([n,t,x,r])=>rv.insertAdjacentHTML('beforeend',`<article class="rc"><div class="st" aria-label="5 stars">★★★★★</div><p>${x}</p><b>${n}</b><small>Google review · ${t}</small>${r?`<div class="rep">${r}</div>`:''}</article>`));
const mv=d=>rv.scrollBy({left:d*(rv.firstElementChild.offsetWidth+18),behavior:'smooth'});pv.onclick=()=>mv(-1);nx.onclick=()=>mv(1);
mb.onclick=()=>{const o=nav.classList.toggle('open');mb.setAttribute('aria-expanded',o)};nav.onclick=e=>{if(e.target.tagName=='A')nav.classList.remove('open')};
const f=document.getElementById('f');
