f.onsubmit=e=>{e.preventDefault();const v=n=>f.elements[n].value.trim(),er=f.querySelectorAll('.er');let bad=0;
const chk=(i,c,m)=>{er[i].textContent=c?'':m;if(!c)bad=1};
chk(0,v('n').length>1,'Please enter your name.');chk(1,/^(\+?91)?[6-9]\d{9}$/.test(v('p').replace(/[\s-]/g,'')),'Enter a valid 10-digit mobile number.');chk(2,v('a').length>2,'Please enter your area.');
if(bad)return;
submitLead(`Hi Techno Cool, I need a visit.\nName: ${v('n')}\nPhone: ${v('p')}\nArea: ${v('a')}\nService: ${v('s')}\nWhen: ${v('w')}${v('m')?'\nProblem: '+v('m'):''}`);document.getElementById('ok').style.display='block'};
