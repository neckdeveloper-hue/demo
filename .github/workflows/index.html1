<script>
const S=[["AC repairing","Not cooling, leaking, noisy or tripping? We find the fault first.","<path class='f' d='M8 14h48v16H8z'/><path class='s' d='M12 25h40M40 40l-8 6 8 6M26 52l8-6'/>"],
["AC installation","Neat mounting, piping and wiring for split and cassette units.","<path class='f' d='M6 12h40v14H6z'/><path class='s' d='M10 22h32M50 18h8v36H50zM54 30a3 3 0 100 .1'/>"],
["Servicing & cleaning","Coil, filter and drain cleaning so cooling and airflow come back.","<path class='f' d='M8 14h48v16H8z'/><path class='s' d='M16 38l4 8m8-8l4 8m8-8l4 8'/>"],
["Gas refilling","Leak check, then the right refrigerant gas for your AC.","<rect class='f' x='20' y='18' width='24' height='38' rx='9'/><path class='s' d='M28 18v-6h8v6M24 34h16'/>"],
["Duct & vent repair","Repair and cleaning for duct and vent work.","<path class='f' d='M6 22h52v18H6z'/><path class='s' d='M18 22v18M32 22v18M46 22v18'/>"],
